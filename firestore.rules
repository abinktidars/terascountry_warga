rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myRole() {
      return isSignedIn()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : 'public';
    }

    function isPengurus() {
      return myRole() == 'pengurus';
    }

    function isWargaOrPengurus() {
      return myRole() == 'warga' || myRole() == 'pengurus';
    }

    // profil user: role, nama, unit, dll — 1 dokumen per akun (id = uid)
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow update: if isSignedIn() && (request.auth.uid == uid || isPengurus());
      allow delete: if isPengurus();
    }

    // data warga per unit (dikelola pengurus)
    match /residents/{id} {
      allow read: if isWargaOrPengurus();
      allow write: if isPengurus();
    }

    // IPL: status pembayaran per unit
    match /units/{unitId} {
      allow read: if isWargaOrPengurus();
      allow write: if isPengurus();
    }

    // keluhan warga
    match /complaints/{id} {
      allow read: if isWargaOrPengurus();
      allow create: if isWargaOrPengurus() && request.resource.data.reporterUid == request.auth.uid;
      allow update, delete: if isPengurus();
    }

    // pengumuman: publik bisa baca yg aud = 'publik', warga/pengurus baca semua
    match /announcements/{id} {
      allow read: if resource.data.aud == 'publik' || isWargaOrPengurus();
      allow write: if isPengurus();
    }

    // data referensi: kegiatan, piket, aset, sosial, paguyuban — baca publik, tulis pengurus saja
    match /{collection}/{id} {
      allow read: if collection in ['events', 'piket', 'assets', 'social', 'paguyuban'];
      allow write: if isPengurus();
    }

    // default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
